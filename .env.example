PUBLIC_BASE_URL=https://social.example.com
HTTP_LISTEN_ADDRESS=127.0.0.1:8080
SQLITE_PATH=/var/lib/social-mcp/social.db
MEDIA_DIRECTORY=/var/lib/social-mcp/media
BACKUP_DIRECTORY=/var/backups/social-mcp
SCHEDULER_POLL_INTERVAL=3s
SCHEDULER_MAX_RETRIES=5
CREDENTIAL_ENCRYPTION_KEY=
SOCIAL_OPERATOR_TOKEN=
SOCIAL_AGENT_TOKEN=
# Each value is a one-line JSON array. Use the same IDs when rotating bearer tokens.
SOCIAL_ACCOUNTS='[{"id":"wa","platform":"whatsapp","name":"WhatsApp","session":"default"},{"id":"linkedin","platform":"linkedin","remote_id":"urn:li:person:REPLACE_ME"},{"id":"x","platform":"x","remote_id":"000000"},{"id":"instagram","platform":"instagram","remote_id":"000000"}]'
SOCIAL_CLIENTS='[{"id":"operator","token_env":"SOCIAL_OPERATOR_TOKEN","admin":true,"publish":false,"accounts":{"wa":[],"linkedin":[],"x":[],"instagram":[]}},{"id":"marketing-agent","token_env":"SOCIAL_AGENT_TOKEN","publish":false,"accounts":{}}]'
WAHA_BASE_URL=http://127.0.0.1:3000
WAHA_API_KEY=
WAHA_PREVIEW_HOSTS=
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v26.0
X_CLIENT_ID=
X_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202609
# Optional. Use only for a client which connects via OAuth discovery.
MCP_OAUTH_ISSUER=
MCP_OAUTH_INTROSPECTION_URL=
MCP_OAUTH_CLIENT_ID=
MCP_OAUTH_CLIENT_SECRET=
